		TweenService:Create(slideFrame, tweenInfo, {Size = UDim2.new(pos, 0, 1, 0)}):Play()
	
		local currentValue = math.floor((MIN_VALUE + (pos * (MAX_VALUE - MIN_VALUE))) * 100) / 100 
