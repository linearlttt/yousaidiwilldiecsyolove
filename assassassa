				Point = myPosition, -- Changed from godZone to your position
				Hit = hitPart,
				Limb = "",
				Class = currentClass, 
				Result = {
					Position = myPosition, -- Changed from godZone to your position
					Instance = Workspace,
					Normal = Vector3.new(0, 1, 0)
				}
			}
		}
		remote:FireServer(unpack(args))
	end
	
	-- UI VISUALS
