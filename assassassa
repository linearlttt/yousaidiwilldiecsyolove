		local deadConn = hum.Died:Connect(function()
			clean()
		end)
		table.insert(conns, deadConn)
	
		-- 3. EVENT-BASED AUTO RESET (No task.spawn, no while loops!)
		local function checkAutoReset()
			if buttons.AutoReset:GetAttribute("Active") and pvp and pvp.Value then
				if char:FindFirstChild("NO_GAMEPASS") then
					hum.Health = 0
					clean()
				end
			end
		end
	
		-- Check immediately when spawning
		checkAutoReset()
	
		-- Check if the "NO_GAMEPASS" object gets added later
		local childConn = char.ChildAdded:Connect(function()
			checkAutoReset()
		end)
		table.insert(conns, childConn)
	
		-- Check if PVP status flips to true/false dynamically
		if pvp then
			local pvpConn = pvp.Changed:Connect(function()
				checkAutoReset()
			end)
			table.insert(conns, pvpConn)
