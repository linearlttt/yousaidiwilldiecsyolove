									ContactServerTime = workspace:GetServerTimeNow()
								},
								false
							)
						end
					end
				end
			end
	
			task.wait() -- Attack loop interval
		end
	end)
	
	-- Button click listener
	button.MouseButton1Click:Connect(function()
