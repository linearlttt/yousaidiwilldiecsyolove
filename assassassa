	-- ==========================================
	type Settings = {
		WeaveEnabled: boolean,
		WeaveInterval: number,
		MicroInterval: number,
		MaxDistance: number,
		WeaveDuration: number
	}
	
	local Config: Settings = {
		WeaveEnabled = false,
		WeaveInterval = 0,
		MicroInterval = 0,
		MaxDistance = 30,
		WeaveDuration = 0.33
	}
	
	local MIN_VALUE, MAX_VALUE = 0, 1
	local dragging = false
	local wipEnabled = false 
	local isAutoTracking = false 
	
	-- Garbage Collection / Lifecycle Object Pools
	local Janitor = { Connections = {}, TrackingPlayers = {} }
	
